lstparams "language=Python,fontfamily=tt,fontsize={\scriptsize},breaklines=true,tabsize=4"
inline true
status open

\begin_layout Plain Layout
__hash__
\end_layout

\end_inset

.
\end_layout

\begin_layout Subsubsection
Ordering
\end_layout

\begin_layout Definition
A binary relation 
\begin_inset Formula $\mathord{\lesssim}$
\end_inset

 on a set 
\begin_inset Formula $X$
\end_inset

 is called a 
\emph on
preorder
\emph default
 if it is reflexive and transitive:
\end_layout

\begin_deeper
\begin_layout Description
reflexivity 
\begin_inset Formula $\forall a\in X$
\end_inset

,
 
\begin_inset Formula $a\lesssim a$
\end_inset

,
 i.e.
 every element is related to itself.
\end_layout

\begin_layout Description
transitivity 
\begin_inset Formula $\forall a,b,c\in X$
\end_inset

 with 
\begin_inset Formula $a\lesssim b$
\end_inset

 and 
\begin_inset Formula $b\lesssim c$
\end_inset

,
 
\begin_inset Formula $a\lesssim c$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Standard
Given a preorder 
\begin_inset Formula $\lesssim$
\end_inset

 on 
\begin_inset Formula $X$
\end_inset

 one may define an equivalence relation 
\begin_inset Formula $\sim$
\end_inset

 on 
\begin_inset Formula $X$
\end_inset

 by
\begin_inset Formula 
\[
a\lesssim b\text{ and }b\lesssim a\text{ iff }a\sim b
\]

\end_inset


\begin_inset Formula $\forall a,b\in X$
\end_inset

.
\end_layout

\begin_layout Minisec
Partial
\end_layout

\begin_layout Definition
A 
\emph on
partial order
\emph default
 
\begin_inset Formula $\mathord{\leq}$
\end_inset

 is a preorder on a set 
\begin_inset Formula $X$
\end_inset

 that is antisymmetric:
\end_layout

\begin_deeper
\begin_layout Description
antisymmetry 
\begin_inset Formula $\forall a,b\in X$
\end_inset

,
 if 
\begin_inset Formula $a\leq b$
\end_inset

 and 
\begin_inset Formula $b\leq a$
\end_inset

,
 then 
\begin_inset Formula $a=b$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Standard
Formally,
 a partial order is a binary relation that is reflexive,
 antisymmetric and transitive.
 A 
\emph on
partially ordered set
\emph default
 (
\emph on
poset
\emph default
 for short) is a set 
\begin_inset Formula $X$
\end_inset

 (called the ground set of the order) equipped with a partial order.
\end_layout

\begin_layout Standard
Given a preorder 
\begin_inset Formula $\lesssim$
\end_inset

 on 
\begin_inset Formula $X$
\end_inset

 and the equivalence relation 
\begin_inset Formula $\sim$
\end_inset

 it implies,
 one may define a partial order 
\begin_inset Formula $\leq$
\end_inset

 on 
\begin_inset Formula $X/\mathord{\sim}$
\end_inset

,
 by
\begin_inset Formula 
\[
[a]\leq[b]\text{ iff }a\lesssim b
\]

\end_inset


\begin_inset Formula $\forall a,b\in X$
\end_inset

.
\end_layout

\begin_layout Definition
A 
\emph on
strict partial order
\emph default
 
\begin_inset Formula $<$
\end_inset

 is a binary relation on 
\begin_inset Formula $X$
\end_inset

 that is irreflexive and transitive:
\end_layout

\begin_deeper
\begin_layout Description
irreflexivity 
\begin_inset Formula $\forall a\in X$
\end_inset

,
 
\begin_inset Formula $\neg(a<a)$
\end_inset

.
\end_layout

\begin_layout Description
transitivity 
\begin_inset Formula $\forall a,b,c\in X$
\end_inset

 with 
\begin_inset Formula $a<b$
\end_inset

 and 
\begin_inset Formula $b<c$
\end_inset

,
 
\begin_inset Formula $a<c$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Standard
Any preorder 
\begin_inset Formula $\lesssim$
\end_inset

 on a set 
\begin_inset Formula $X$
\end_inset

 gives rise to a strict partial order defined (using the induced equivalence relation 
\begin_inset Formula $\sim$
\end_inset

) by
\begin_inset Formula 
\[
a<b\text{ iff }a\lesssim b\text{ and }a\nsim b
\]

\end_inset


\begin_inset Formula $\forall a,b\in X$
\end_inset

.
 A partial order on 
\begin_inset Formula $X$
\end_inset

 gives rise to the same strict partial order,
 hence using the same name.
\end_layout

\begin_layout Minisec
Total
\end_layout

\begin_layout Definition
A 
\emph on
total order
\emph default
 
\begin_inset Formula $\leq$
\end_inset

 on some set 
\begin_inset Formula $X$
\end_inset

 is a partial order in which any two elements are comparable,
 that is:
\end_layout

\begin_deeper
\begin_layout Description
strong
\begin_inset space ~
\end_inset

connectivity 
\begin_inset Formula $\forall a,b\in X$
\end_inset

,
 
\begin_inset Formula $a\leq b$
\end_inset

 or 
\begin_inset Formula $b\leq a$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Definition
Note that,
 reflexivity in total orders follows from strong connectivity.
\end_layout

\begin_layout Definition
A 
\emph on
strict total order
\emph default
 
\begin_inset Formula $\leq$
\end_inset

 on a set 
\begin_inset Formula $X$
\end_inset

 is a strict partial order in which any two elements are comparable,
 that is:
\end_layout

\begin_deeper
\begin_layout Description
connectivity 
\begin_inset Formula $\forall a,b\in X$
\end_inset

,
 if 
\begin_inset Formula $a\neq b$
\end_inset

,
 then 
\begin_inset Formula $a<b$
\end_inset

 or 
\begin_inset Formula $b>a$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Standard
A total order 
\begin_inset Formula $\leq$
\end_inset

 on a set 
\begin_inset Formula $X$
\end_inset

 implies a strict total order 
\begin_inset Formula $<$
\end_inset

 by
\begin_inset Formula 
\[
a<b\text{ iff }a\leq b\text{ and }a\neq b
\]

\end_inset


\begin_inset Formula $\forall a,b\in X$
\end_inset

.
\end_layout

\begin_layout Paragraph
Extrema
\end_layout

\begin_layout Definition
A poset can have at most one greatest and one least element:
\end_layout

\begin_deeper
\begin_layout Itemize
An element 
\begin_inset Formula $M=\max X\in X$
\end_inset

 is the greatest element iff 
\begin_inset Formula $\forall a\in X$
\end_inset

,
 
\begin_inset Formula $a\leq M$
\end_inset

.
\end_layout

\begin_layout Itemize
An element 
\begin_inset Formula $m=\min X\in X$
\end_inset

 is the least element iff 
\begin_inset Formula $\forall a\in X$
\end_inset

,
 
\begin_inset Formula $m\leq a$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Section
Algebra
\end_layout

\begin_layout Definition
A 
\emph on
binary operation
\emph default
 
\begin_inset Formula $\bullet_{X}$
\end_inset

 is a mapping of the elements (pairs) of the cartesian product 
\begin_inset Formula $X\times X$
\end_inset

 to 
\begin_inset Formula $X$
\end_inset

:
\begin_inset Formula 
\[
\bullet_{X}:X\times X\to X
\]

\end_inset


\end_layout

\begin_layout Standard
Binary operations are usually written using infix notation such as 
\begin_inset Formula $a\bullet_{X}b$
\end_inset

 rather than by functional notation.
\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $X$
\end_inset

 be a set equipped with one or several methods of producing elements of 
\begin_inset Formula $X$
\end_inset

 from other elements of 
\begin_inset Formula $A$
\end_inset

 (operations).
 A subset 
\begin_inset Formula $A\subseteq X$
\end_inset

 is said to be 
\emph on
closed
\emph default
 under these methods if an input of (purely) elements of 
\begin_inset Formula $A$
\end_inset

 always results in an element still in 
\begin_inset Formula $A$
\end_inset

,
 or 
\begin_inset Formula $\forall a,b\in A$
\end_inset

,
 
\begin_inset Formula $a\bullet_{X}b\in A$
\end_inset

.
\end_layout

\begin_layout Standard
It follows that 
\begin_inset Formula $\forall A\subseteq X$
\end_inset

,
 there is a smallest closed subset 
\begin_inset Formula $\bar{A}\subseteq S$
\end_inset

 such that 
\begin_inset Formula $A\subseteq\bar{A}$
\end_inset

 (it is the intersection fo all closed subsets that contain 
\begin_inset Formula $A$
\end_inset

).
 Depending on the context,
 
\begin_inset Formula $\bar{A}$
\end_inset

 is called the closure of 
\begin_inset Formula $A$
\end_inset

.
\end_layout

\begin_layout Example
Given the operation of subtraction 
\begin_inset Formula $-:\mathbb{Q}\times\mathbb{Q}\to\mathbb{Q}$
\end_inset

 on the rationals,
 the closure of 
\begin_inset Formula $\mathbb{N}$
\end_inset

 is 
\begin_inset Formula $\bar{\mathbb{N}}=\mathbb{Z}$
\end_inset

.
 Given the operation of division 
\begin_inset Formula $/:\mathbb{Q}^{*}\times\mathbb{Q}^{*}\to\mathbb{Q}^{*}$
\end_inset

,
 the closure of 
\begin_inset Formula $\mathbb{Z}^{*}$
\end_inset

 is 
\begin_inset Formula $\bar{\mathbb{Z}}^{*}=\mathbb{Q}^{*}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $\forall X\subseteq S$
\end_inset

 closed,
 
\begin_inset Formula $\bar{X}=X$
\end_inset

.
\end_layout

