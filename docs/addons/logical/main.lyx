% Typewriter font: Fira Code, for its programming ligatures, with graceful fallbacks.
% Fira Code is not part of TeX Live, so it is taken from the system when installed
% there, Retina weight preferred; otherwise TeX Live's own Fira Mono keeps the same
% design without the ligatures. LyX loads fontspec before this preamble, so the test
% is available here, and the choice made here overrides the document settings.
\IfFontExistsTF{Fira Code}{%
  \IfFontExistsTF{Fira Code Retina}
    {\setmonofont{Fira Code}[UprightFont=* Retina, BoldFont=* Bold, Contextuals=Alternate, Scale=MatchLowercase]}
    {\setmonofont{Fira Code}[Contextuals=Alternate, Scale=MatchLowercase]}%
}{%
  \IfFontExistsTF{Fira Mono}{\setmonofont{Fira Mono}[Scale=MatchLowercase]}{}%
}

\usepackage[framemethod=TikZ]{mdframed}

\definecolor{code}{HTML}{EEEEEE}
\definecolor{codeborder}{HTML}{DDDDDD}

\mdfdefinestyle{codebox}{
    backgroundcolor=code,
    linecolor=codeborder,
    linewidth=0.5pt,
    roundcorner=5pt,
    innerleftmargin=5pt,
    innerrightmargin=5pt,
    innertopmargin=5pt,
    innerbottommargin=5pt,
    skipabove=\glueexpr 3.75pt + \parskip\relax,
}
\mdfsetup{
    skipbelow=\glueexpr 6.25pt - \parskip\relax
}
\surroundwithmdframed[style=codebox]{minted}
% Listings included from files arrive as \inputminted, a command rather than an
% environment, so the hook above never sees them. Give them the same box. Deferred,
% because LyX loads minted after this preamble.
\AtBeginDocument{%
  \let\PlainInputMinted\inputminted
  \renewcommand{\inputminted}[3][]{%
    \begin{mdframed}[style=codebox]\PlainInputMinted[#1]{#2}{#3}\end{mdframed}}%
}
% minted 3 boxes every hyphen, defining \PYGZhy as \mbox{-}, so that a line can never
% break inside an operator such as ->. The box also hides the hyphen from the font's
% shaper, so the arrow ligature never forms. Listings here never break at hyphens
% anyway, fvextra forbids it, so the patch is switched off. Harmless with a minted
% that does not define it.
\makeatletter
\AtBeginDocument{\let\minted@patch@PygmentsZhy\relax}
\makeatother

