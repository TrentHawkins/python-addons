\begin_layout Minisec
Extrema
\end_layout

\begin_layout Definition
A poset can have at most one greatest and one least element:
\end_layout

\begin_deeper
\begin_layout Itemize
An element 
\begin_inset Formula $\max X:X$
\end_inset

 is the greatest element iff 
\begin_inset Formula $\forall a:X\mid a\leq\max X,$
\end_inset


\end_layout

\begin_layout Itemize
An element 
\begin_inset Formula $\min X:X$
\end_inset

 is the least element iff 
\begin_inset Formula $\forall a:X\mid\min X\leq a.$
\end_inset


\end_layout

\end_deeper
\begin_layout Remark
For a family of sets 
\begin_inset Formula $\mathcal{S}$
\end_inset

,
 
\begin_inset Formula $\subseteq$
\end_inset

 is a partial order with 
\begin_inset Formula $\subset$
\end_inset

 its strict partial order counter part,
 with
\begin_inset Formula 
\[
\min\mathcal{S}=\bigcap\mathcal{S}\text{ and }\max\mathcal{S}=\bigcup\mathcal{S},
\]

\end_inset

is any of those are respectively (and indepentendly) included in the family.
\end_layout

