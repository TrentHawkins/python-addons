\begin_layout Subsubsection
\begin_inset CommandInset label
LatexCommand label
name "subsec:Internal-operations"

\end_inset

Internal operations
\end_layout

\begin_layout Standard
There are several standard operations that produce new sets from given sets,
 analogously to how addition and multiplication produce new numbers from given numbers.
 The operations that are considered in this section are those such that all elements of the produced sets belong to a previously defined set.
\end_layout

\begin_layout Minisec
Intersection
\end_layout

\begin_layout Definition
The 
\emph on
intersection
\emph default
 of sets 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 is set denoted 
\begin_inset Formula $A\cap B$
\end_inset

 whose elements are those elements that belong to both 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

.
 That is,
\begin_inset Formula 
\[
A\cap B=\{x\mid x:A\wedge x:B\}.
\]

\end_inset

Thus 
\begin_inset Formula $A\cap B\subseteq A$
\end_inset

 and 
\begin_inset Formula $A\cap B\subseteq B$
\end_inset

.
\end_layout

\begin_layout Standard
Intersection is associative and commutative;
 this means that for proceeding a sequence of intersections,
 one may proceed in any order,
 without the need of parentheses for specifying the order of operations.
\end_layout

\begin_layout Definition
If 
\begin_inset Formula $\mathcal{S}$
\end_inset

 is a nonempty set of sets,
 its intersection,
 denoted
\begin_inset Formula 
\[
\bigcap\nolimits\mathcal{S}=\bigcap\nolimits_{A:\mathcal{S}}A=\{x\mid\forall A:\mathcal{S}\mid x:A\},
\]

\end_inset

is the set whose elements are those elements that belong to all sets in 
\begin_inset Formula $\mathcal{S}$
\end_inset

.
\end_layout

\begin_layout Minisec
Union
\end_layout

\begin_layout Definition
The 
\emph on
union
\emph default
 of sets 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 is a set denoted 
\begin_inset Formula $A\cup B$
\end_inset

 whose elements are those elements that belong to 
\begin_inset Formula $A$
\end_inset

 or 
\begin_inset Formula $B$
\end_inset

 (or both).
 That is,
\begin_inset Formula 
\[
A\cup B=\{x\mid x:A\vee x:B\}.
\]

\end_inset

Thus 
\begin_inset Formula $A\subseteq A\cup B$
\end_inset

 and 
\begin_inset Formula $B\subseteq A\cup B$
\end_inset

.
\end_layout

\begin_layout Standard
Union is associative and commutative.
\end_layout

\begin_layout Definition
If 
\begin_inset Formula $\mathcal{S}$
\end_inset

 is a set of sets,
 its union,
 denoted
\begin_inset Formula 
\[
\bigcup\mathcal{S}=\bigcup\nolimits_{A:\mathcal{S}}A=\{x\mid\exists A:\mathcal{S}\mid x:A\},
\]

\end_inset

is the set whose elements are those elementes that belong to at least one set in 
\begin_inset Formula $\mathcal{S}$
\end_inset

.
\end_layout

\begin_layout Minisec
Set difference
\end_layout

\begin_layout Definition
The 
\emph on
set difference
\emph default
 of set 
\begin_inset Formula $B$
\end_inset

 from 
\begin_inset Formula $A$
\end_inset

,
 is a set,
 denoted 
\begin_inset Formula $A\setminus B$
\end_inset

,
 whose elements are those elements that belong to 
\begin_inset Formula $A$
\end_inset

,
 but not to 
\begin_inset Formula $B$
\end_inset

.
 That is,
\begin_inset Formula 
\[
A\setminus B=\{x\mid x:A\wedge\neg x:B\}.
\]

\end_inset

Note that 
\begin_inset Formula $A\setminus B=A\setminus(A\cap B)$
\end_inset

.
\end_layout

\begin_layout Standard
When 
\begin_inset Formula $B\subseteq A$
\end_inset

 the difference 
\begin_inset Formula $A\setminus B=B^{\complement}$
\end_inset

 is also called the 
\emph on
complement
\emph default
 of 
\begin_inset Formula $B$
\end_inset

 in 
\begin_inset Formula $A$
\end_inset

.
 Naively speaking,
\begin_inset Formula 
\[
B^{\complement}=\{x\mid\neg x:B\},
\]

\end_inset

but this does not lead to a set as is.
 When all sets that are considered are subsets of a fixed 
\emph on
universal set
\emph default
 
\begin_inset Formula $U$
\end_inset

,
 the complement 
\begin_inset Formula $B^{\complement}$
\end_inset

 is often called the absolute complement of 
\begin_inset Formula $B$
\end_inset

.
\end_layout

\begin_layout Standard
Informally however,
\begin_inset Formula 
\[
A\setminus B=A\cap B^{\complement}.
\]

\end_inset


\end_layout

\begin_layout Definition
The 
\emph on
symmetric difference
\emph default
 of sets 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 denoted 
\begin_inset Formula $A\bigtriangleup B$
\end_inset

,
 is the set of those elements that belong to 
\begin_inset Formula $A$
\end_inset

 or 
\begin_inset Formula $B$
\end_inset

 but not on both:
\begin_inset Formula 
\[
A\bigtriangleup B=(A\setminus B)\cup(B\setminus A)=(A\cup B)\setminus(A\cap B).
\]

\end_inset


\end_layout

