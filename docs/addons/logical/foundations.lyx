 In this section,
 other set operations are considered,
 which produce sets whose elements can be outside all previously considered sets.
\end_layout

\begin_layout Minisec
Cartesian product
\end_layout

\begin_layout Definition
Given sets 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 their 
\emph on
Cartesian product
\emph default
 (or simply 
\emph on
product
\emph default
),
 denoted 
\begin_inset Formula $A\times B$
\end_inset

,
 is the set of all ordered pairs 
\begin_inset Formula $(a,b)$
\end_inset

 such that 
\begin_inset Formula $a:A$
\end_inset

 and 
\begin_inset Formula $b:B$
\end_inset

;
 that is,
\begin_inset Formula 
\[
A\times B=\{(a,b)\mid a:A\wedge b:B\}.
\]

\end_inset


\end_layout

\begin_layout Standard
The definition makes sense even if 
\begin_inset Formula $A=B$
\end_inset

,
 in which case we write 
\begin_inset Formula $A\times A=A^{2}$
\end_inset

.
 The graph of a function 
\begin_inset Formula $f:A\to B$
\end_inset

 is the set of all ordered pairs 
\begin_inset Formula $(a,f(a))$
\end_inset

 as 
\begin_inset Formula $a$
\end_inset

 ranged over all elements of 
\begin_inset Formula $A$
\end_inset

.
 It is a subset of the Cartesian product 
\begin_inset Formula $A\times B$
\end_inset

.
\end_layout

\begin_layout Definition
Given an indexed family of sets 
\begin_inset Formula $(A_{i})_{i:I}$
\end_inset

,
 the product
\begin_inset Formula 
\[
\prod\nolimits_{i:I}A_{i}
\]

\end_inset

is the set of all indexed families of elements 
\begin_inset Formula $(a_{i})_{i:I}$
\end_inset

 such that 
\begin_inset Formula $\forall i:I\mid a_{i}:A_{i}$
\end_inset

.
\end_layout

